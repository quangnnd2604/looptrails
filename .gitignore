# WordPress core (this repo tracks only our custom theme/plugin + docs, not core)
/wp-admin/
/wp-includes/
/wp-*.php
!/wp-config-sample.php
/xmlrpc.php
/license.txt
/readme.html
/index.php
/.htaccess
/wp-content/index.php
/wp-content/languages/

# Secrets / local environment
wp-config.php
.env
.env.local
*.log

# Uploads (user/demo media, not source code)
/wp-content/uploads/

# Default WordPress themes/plugins we are not modifying
/wp-content/themes/twentytwentyfive/
/wp-content/themes/twentytwentyfour/
/wp-content/themes/twentytwentythree/
/wp-content/themes/twentytwentytwo/
/wp-content/plugins/akismet/
/wp-content/plugins/hello.php
/wp-content/plugins/index.php
/wp-content/themes/index.php

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages)
/.superpowers/

# Cache / OS / editor cruft
/wp-content/cache/
/wp-content/upgrade/
/wp-content/backup*/
node_modules/
.DS_Store
Thumbs.db

# Reference screenshot captures (large binaries, regenerable via script)
/docs/reference-screenshots/

# Design measurement raw data (contains short reference-site text samples for
# identification — local-only evidence, same treatment as reference-screenshots/)
/docs/design-measurements/*
!/docs/design-measurements/README.md

# Companion plugin PHPUnit/Composer dev dependencies (reinstall via `composer install`)
/wp-content/plugins/tour-booking-core/vendor/
/wp-content/plugins/tour-booking-core/.phpunit.result.cache

# Theme PHPUnit/Composer dev dependencies (reinstall via `composer install`)
/wp-content/themes/tour-reference-theme/vendor/
